# 6. 실행
# ----------------------------------------------------------------------------
def md_table(df: pd.DataFrame, fmt="{:.3f}") -> str:
    head = "| " + " | ".join(df.columns) + " |\n|" + "---|" * len(df.columns) + "\n"
    body = ""
    for _, r in df.iterrows():
        body += "| " + " | ".join(fmt.format(v) if isinstance(v, (float, np.floating)) else str(v) for v in r) + " |\n"
    return head + body


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--data", nargs="+", help="CSV 파일 또는 CSV가 든 폴더(여러 개 가능)")
    ap.add_argument("--demo", action="store_true", help="합성 데이터로 코드만 점검(결과는 실제 성능이 아님)")
    ap.add_argument("--eda-only", action="store_true", help="분포 확인만 수행(스냅샷 1장이어도 가능)")
    ap.add_argument("--outdir", default="results")
    ap.add_argument("--thr", nargs=2, type=float, default=[0.50, 0.85], metavar=("LOW", "HIGH"),
                    help="혼잡도 경계. 기본 0.50 0.85")
    ap.add_argument("--interval-min", type=int, default=10, help="수집 간격(분). 30의 약수여야 함")
    ap.add_argument("--horizon-min", type=int, default=30)
    ap.add_argument("--test-frac", type=float, default=0.2)
    ap.add_argument("--val-frac", type=float, default=0.2)
    ap.add_argument("--max-train", type=int, default=20000, help="SVM 학습 표본 상한(0이면 제한 없음)")
    ap.add_argument("--max-val", type=int, default=10000)
    ap.add_argument("--no-balance", action="store_true", help="클래스 가중치 균형(balanced)을 끈다")
    ap.add_argument("--holidays", nargs="*", default=[], help="공휴일 날짜(YYYY-MM-DD)")
    ap.add_argument("--drop-constant-lots", action="store_true",
                    help="관측 내내 차량 수가 변하지 않은 주차장(센서 정지 의심)을 제외")
    ap.add_argument("--fast", action="store_true", help="하이퍼파라미터 격자 축소(빠른 점검용)")
    ap.add_argument("--seed", type=int, default=42)
    a = ap.parse_args()
    if not a.demo and not a.data:
        ap.error("--data 또는 --demo 중 하나가 필요합니다.")
    if not 0 < a.thr[0] < a.thr[1] <= 1.5:
        ap.error("--thr 는 '낮은값 높은값' 순서의 점유율 비율이어야 합니다 (예: --thr 0.50 0.85, 퍼센트 아님).")

    thr = tuple(a.thr)
    rng = np.random.default_rng(a.seed)
    os.makedirs(a.outdir, exist_ok=True)

    if a.demo:
        print("=" * 70 + "\n[DEMO] 합성 데이터입니다. 아래 수치는 실제 주차장 성능이 아닙니다.\n" + "=" * 70)
        df = make_demo(interval_min=a.interval_min, seed=a.seed)
    else:
        try:
            df = load_snapshots(a.data, a.interval_min, a.drop_constant_lots)
        except (FileNotFoundError, ValueError) as e:
            print(f"\n[중단] {e}")
            raise SystemExit(1)

    eda(df, thr, a.outdir)
    if a.eda_only:
        return

    try:
        data, lags = build_dataset(df, a.interval_min, a.horizon_min, thr, a.holidays)
        inner, val, train_full, test, test_start, val_start = time_split(data, a.horizon_min, a.test_frac, a.val_frac)
    except ValueError as e:
        print(f"\n[중단] {e}\n분포 확인(EDA) 결과는 {os.path.abspath(a.outdir)} 에 저장되어 있습니다.")
        raise SystemExit(1)
    days = (data["t"].max() - data["t"].min()).days + 1
    if days < 14:
        print(f"[경고] 데이터 기간이 {days}일입니다. 요일 패턴을 보려면 2주 이상을 권장합니다.")
    print(f"\n[split] 학습 {len(train_full):,} (내부 학습 {len(inner):,} + 검증 {len(val):,}) / 테스트 {len(test):,}")
    print(f"        검증 시작 {val_start.date()}, 테스트 시작 {test_start.date()} "
          f"(테스트 {test['t'].dt.normalize().nunique()}일, 주말·휴일 {test.loc[test['is_off'] == 1, 't'].dt.normalize().nunique()}일)")

    split_share = {nm: share_table(d["occ_future"], thr) for nm, d in
                   [("학습", train_full), ("검증", val), ("테스트", test)]}
    for nm, s in split_share.items():
        print(f"        {nm} 클래스 비율(여유/보통/혼잡): " + " / ".join(f"{x * 100:.1f}%" for x in s))
    if min(split_share["학습"]) < 0.05:
        print("[경고] 학습 구간에서 5% 미만인 클래스가 있습니다. --thr 로 경계 조정을 검토하세요(학습 구간 분포만 보고 정할 것).")
    # 경계는 학습 구간 분포만 보고 정한다: 후보별 비율을 학습 구간(30분 뒤 점유율)만으로 따로 저장
    cand = ["## 학습 구간 기준 후보별 클래스 비율 (%, 여유/보통/혼잡; 30분 뒤 점유율, 학습 구간만)",
            *threshold_candidate_lines(train_full["occ_future"]),
            "", "경계를 바꿔 다시 실행해도 시간 분할 지점은 그대로이므로, 이 표를 보고 --thr 를 정해도 테스트 구간은 보지 않은 셈입니다."]
    with open(os.path.join(a.outdir, "threshold_candidates_train.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(cand) + "\n")
    print("\n".join(cand[:5]))
    if not a.holidays:
        print("[알림] --holidays 를 주지 않았습니다. 평일에 낀 공휴일은 평일로 취급됩니다 "
              "(수집 기간에 공휴일이 있으면 YYYY-MM-DD 로 넘기세요).")

    # --- 특징 행렬: 검증용(내부 학습 통계) / 최종용(학습 전체 통계)
    st_in, st_full = fit_lot_stats(inner), fit_lot_stats(train_full)
    X_in, X_val = feature_matrix(inner, lags, st_in), feature_matrix(val, lags, st_in)
    X_tr, X_te = feature_matrix(train_full, lags, st_full), feature_matrix(test, lags, st_full)
    y_te, now_te = test["y_true"].to_numpy(), test["y_now"].to_numpy()

    results: dict[str, dict] = {}
    preds = {"y_true": y_te}

    # --- 기준선
    maj = int(np.bincount(train_full["y_true"], minlength=3).argmax())
    results["기준선: 최빈 클래스"] = class_metrics(y_te, np.full_like(y_te, maj), now_te)
    results["기준선: 지금 그대로"] = class_metrics(y_te, now_te, now_te)
    preds["기준선: 최빈 클래스"], preds["기준선: 지금 그대로"] = np.full_like(y_te, maj), now_te

    # --- SVM 계열
    class_weight = None if a.no_balance else "balanced"
    reg_rows = [{"모델": "지금 그대로(점유율 그대로)", "MAE": mean_absolute_error(test["occ_future"], test["occ"]),
                 "RMSE": mean_squared_error(test["occ_future"], test["occ"]) ** 0.5}]
    chosen = {}
    # 모델 간 비교가 표본 차이에 흔들리지 않도록, 모든 SVM이 같은 학습·검증 표본을 쓴다
    sel_in, sel_val, sel_tr = (choose(len(inner), a.max_train, rng), choose(len(val), a.max_val, rng),
                               choose(len(train_full), a.max_train, rng))
    yv_cls, now_v = val["y_true"].to_numpy()[sel_val], val["y_now"].to_numpy()[sel_val]
    Xv = X_val[sel_val]
    for name, spec in model_specs(class_weight, a.fast).items():
        kind = spec["kind"]
        ycol = "occ_future" if kind == "reg" else "y_true"
        Xa, ya = X_in[sel_in], inner[ycol].to_numpy()[sel_in]
        best, best_f1 = None, -1.0
        for p in spec["grid"]:
            t0 = time.time()
            m = spec["build"](p).fit(Xa, ya)
            f1 = class_metrics(yv_cls, predict_class(m, kind, Xv, thr)[0], now_v)["macro_f1"]
            print(f"[tune] {name} {p} 검증 macro F1 {f1:.4f} ({time.time() - t0:.0f}s)")
            if f1 > best_f1:
                best, best_f1 = p, f1
        chosen[name] = {"params": best, "val_macro_f1": best_f1}
        Xb, yb = X_tr[sel_tr], train_full[ycol].to_numpy()[sel_tr]
        model = spec["build"](best).fit(Xb, yb)
        pred, occ_hat = predict_class(model, kind, X_te, thr)
        results[name] = class_metrics(y_te, pred, now_te)
        preds[name] = pred
        if occ_hat is not None:
            preds["SVR 점유율 예측"] = occ_hat
            reg_rows.append({"모델": "SVR", "MAE": mean_absolute_error(test["occ_future"], occ_hat),
                             "RMSE": mean_squared_error(test["occ_future"], occ_hat) ** 0.5})
        print(f"[test] {name} {best} macro F1 {results[name]['macro_f1']:.4f}")

    # --- 저장
    cols = ["macro_f1", "accuracy"] + [f"recall_{c}" for c in CLASS_NAMES] + ["acc_전환구간", "acc_유지구간"]
    table = pd.DataFrame({k: {c: v[c] for c in cols} for k, v in results.items()}).T
    table.index.name = "모델"
    table.to_csv(os.path.join(a.outdir, "metrics.csv"), encoding="utf-8-sig")
    for k, v in results.items():
        pd.DataFrame(v["cm"], index=[f"실제_{c}" for c in CLASS_NAMES], columns=[f"예측_{c}" for c in CLASS_NAMES]) \
            .to_csv(os.path.join(a.outdir, f"confusion_{k.replace(':', '').replace(' ', '_').replace('→', '_')}.csv"),
                    encoding="utf-8-sig")
    out_pred = test[["lot_id", "t", "occ", "occ_future", "y_now"]].reset_index(drop=True).copy()
    for k, v in preds.items():
        out_pred[k] = v
    out_pred.to_csv(os.path.join(a.outdir, "test_predictions.csv"), index=False, encoding="utf-8-sig")
    plot_confusions(results, os.path.join(a.outdir, "confusion_matrices.png"),
                    "  [합성 데이터]" if a.demo else "")

    reg = pd.DataFrame(reg_rows)
    reg.to_csv(os.path.join(a.outdir, "regression_metrics.csv"), index=False, encoding="utf-8-sig")
    cfg = {"demo": a.demo, "thresholds": thr, "interval_min": a.interval_min, "horizon_min": a.horizon_min,
           "lags_min": lags, "class_weight": class_weight, "max_train": a.max_train, "seed": a.seed,
           "n_rows": {"train_full": len(train_full), "inner": len(inner), "val": len(val), "test": len(test)},
           "val_start": str(val_start.date()), "test_start": str(test_start.date()),
           "class_share_by_split(여유/보통/혼잡)": split_share, "chosen": chosen}
    with open(os.path.join(a.outdir, "run_config.json"), "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2, default=str)
    with open(os.path.join(a.outdir, "summary.md"), "w", encoding="utf-8") as f:
        if a.demo:
            f.write("> **합성 데이터로 코드만 점검한 결과입니다. 실제 성능이 아닙니다.**\n\n")
        f.write("## 테스트 구간 분류 성능\n\n" + md_table(table.reset_index()) + "\n")
        f.write("\n## 점유율 회귀 오차\n\n" + md_table(reg) + "\n")
        f.write("\n## 선택된 하이퍼파라미터(검증 macro F1 기준)\n\n"
                + "\n".join(f"- {k}: {v['params']} (검증 macro F1 {v['val_macro_f1']:.3f})" for k, v in chosen.items()) + "\n")
    print("\n" + md_table(table.reset_index()))
    print(f"결과 저장: {os.path.abspath(a.outdir)}")


if __name__ == "__main__":
    main()
